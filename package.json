{
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "start": "php artisan serve",
        "controller": "php artisan make:controller",
        "model": "php artisan make:model",
        "migration": "php artisan make:migration",
        "migrate": "php artisan migrate",
        "refresh": "php artisan migrate:refresh",
        "request": "php artisan make:request",
        "dropDB": "php artisan db:wipe",
        "middleware": "php artisan make:middleware",
        "build": "php artisan cache:clear && php artisan view:clear && cd public && py script.py && cd ../ && vite build && cd ../ && py t.py"
    },
    "devDependencies": {
        "@fortawesome/fontawesome-free": "^6.5.1",
        "@headlessui/react": "^1.4.2",
        "@inertiajs/react": "^1.0.0",
        "@tailwindcss/forms": "^0.5.3",
        "@vitejs/plugin-react-swc": "^3.5.0",
        "autoprefixer": "^10.4.18",
        "axios": "^1.6.7",
        "laravel-vite-plugin": "^1.0.0",
        "postcss": "^8.4.35",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "tailwindcss": "^3.4.1",
        "vite": "^5.1.4"
    },
    "dependencies": {
        "@splidejs/react-splide": "^0.7.12",
        "flowbite-react": "^0.7.3",
        "react-quill": "^2.0.0",
        "react-responsive-carousel": "^3.2.23",
        "react-toastify": "^10.0.4",
        "swr": "^2.2.5"
    }
}
